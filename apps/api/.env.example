# ── StringMind API environment ──
# Copy to apps/api/.env for local development. NEVER commit a real .env. Production values: docs/DEPLOY_RENDER.md
NODE_ENV=development
PORT=4700
# Unset → 127.0.0.1 locally, 0.0.0.0 when NODE_ENV=production.
HOST=127.0.0.1
# Browser origin(s) of the web app, comma-separated (CORS + WebSocket Origin check). Host-only values get https://.
WEB_ORIGIN=http://localhost:3700

# ── Database ──
# Leave DATABASE_URL empty to use embedded PGlite (Postgres+pgvector in-process, data in PGLITE_DIR).
# Production REQUIRES a PostgreSQL server with the pgvector extension, e.g.
# DATABASE_URL=postgres://aix:aix@localhost:5432/aix
# External managed URLs usually need TLS: append ?sslmode=require or set DATABASE_SSL=require.
DATABASE_URL=
DB_POOL_MAX=10
# require | verify-full | disable (unset → decided by ?sslmode= in DATABASE_URL)
DATABASE_SSL=
PGLITE_DIR=./.data/pglite
# Raw uploaded knowledge files (only needed until ingested; chunks + embeddings live in the database).
STORAGE_DIR=./storage

# ── Security ──
# 64 hex chars (32 bytes). Required in production. KEEP IT STABLE: it encrypts stored agent credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   or   openssl rand -hex 32
ENCRYPTION_KEY=
# Secure (HTTPS-only) session cookie. Unset → true in production, false otherwise.
COOKIE_SECURE=false
# Fastify trustProxy: true (client IP = left-most X-Forwarded-For) | false | hop count (e.g. 2)
TRUST_PROXY=true
# fatal | error | warn | info | debug | trace | silent  (default: info in production, warn otherwise)
LOG_LEVEL=
# SSRF guard: allow agent endpoint / webhook URLs on loopback, private or link-local networks
# (127.0.0.1, 10.x, 192.168.x, 169.254.x incl. cloud metadata, ::1, fc00::/7 ...).
# Unset → true in development/test (so local Ollama/Llama on localhost works), false in production.
# Keep it false (or unset) in production.
# ALLOW_PRIVATE_NETWORK_URLS=true

# ── Seeded platform administrator ──
# Dev defaults below. In production ADMIN_PASSWORD is REQUIRED and must not be the dev default (the API refuses to start).
ADMIN_EMAIL=admin@aix.local
ADMIN_PASSWORD=AixAdmin!2026

# ── Economy ──
# AIX is a pure IDLE Token economy (docs/IDLE_TOKENS.md): tokens cannot be bought or withdrawn.
# Fiat endpoints (packages, purchase, payments, invoices, payouts, provider webhooks) answer 410 fiat_disabled
# unless FIAT_ENABLED=true. Keep it false. PAYMENT_PROVIDER is only read by the dormant fiat path.
FIAT_ENABLED=false
PAYMENT_PROVIDER=sandbox
# Seed demo organisation, sandbox agents and baseline assessments on first boot.
SEED_DEMO=true

# ── Jobs ──
JOB_POLL_MS=750
DISABLE_JOBS=false

# ── Optional: platform evaluator LLM for rubric grading of open-ended answers ──
EVALUATOR_PROVIDER=
EVALUATOR_API_KEY=
EVALUATOR_MODEL=
