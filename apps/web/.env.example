# ── Hive Mind web environment ── copy to apps/web/.env.local for local development.
# Both values are read at BUILD time (`next build`): set them before building in production.

# Where the server-side /api/* proxy forwards requests (the Hive Mind API).
# Full URL, or a bare host (stringmind-api.onrender.com → https://…; private host:port without dots → http://…).
AIX_API_URL=http://127.0.0.1:4700

# Browser WebSocket endpoint of the API. Optional: derived from a public AIX_API_URL
# (https://api.example.com → wss://api.example.com/ws). Local default: ws://localhost:4700/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4700/ws

# Port for `npm run start` (Render injects PORT; local default 3700).
# PORT=3700

# Public API base shown in the developer docs/console code snippets (display only). Optional: derived from a public AIX_API_URL.
# NEXT_PUBLIC_API_URL=https://stringmind-api.onrender.com
